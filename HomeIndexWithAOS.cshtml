
@model ClubMaster3.Models.HomeStatsViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- AOS CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet" />

<style>
    .stat-card {
        transition: transform 0.3s ease;
        background-color: rgba(255, 255, 255, 0.85);
        border-left: 5px solid #007bff;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0 15px rgba(0, 123, 255, 0.4);
    }
    .hero-section {
        padding-top: 40px;
        padding-bottom: 30px;
    }
    .carousel-item img {
        max-height: 380px;
        object-fit: cover;
    }
    .carousel-caption h5 a {
        color: white;
        text-decoration: none;
        font-weight: bold;
    }
    .carousel-caption p {
        color: #f1f1f1;
    }
</style>

<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container py-5">
        <h1 class="display-4 fw-bold text-dark" data-aos="fade-up">Organize Everything in Your Club Easily</h1>
        <p class="lead text-secondary mt-3 mb-4" data-aos="fade-up" data-aos-delay="200">
            Manage teams, players, and coaches — all in one smart and simple place.
        </p>
    </div>
</section>

<!-- Carousel Section -->
<div id="clubCarousel" class="carousel slide" data-bs-ride="carousel" data-aos="zoom-in">
    <div class="carousel-inner">
        @foreach (var player in Model.Players)
        {
            <div class="carousel-item @(player == Model.Players.First() ? "active" : "")">
                <img src="@(!string.IsNullOrEmpty(player.ImagePath) ? player.ImagePath : "/images/default-player.jpg")" class="d-block w-100" alt="player">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded">
                    <h5>@player.Name</h5>
                    <p>Player - @player.Position</p>
                </div>
            </div>
        }
        @foreach (var coach in Model.Coaches)
        {
            <div class="carousel-item">
                <img src="@(!string.IsNullOrEmpty(coach.ImagePath) ? coach.ImagePath : "/images/default-coach.jpg")" class="d-block w-100" alt="coach">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded">
                    <h5>@coach.Name</h5>
                    <p>Coach - @coach.Phone</p>
                </div>
            </div>
        }
        @foreach (var team in Model.Teams)
        {
            <div class="carousel-item">
                <img src="@(!string.IsNullOrEmpty(team.ImagePath) ? team.ImagePath : "/images/default-team.jpg")" class="d-block w-100" alt="team">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded">
                    <h5>@team.Name</h5>
                    <p>Team - @team.City</p>
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#clubCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#clubCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<!-- Statistics Section -->
<section class="my-5">
    <div class="container text-center" data-aos="fade-up">
        <div class="row g-4 justify-content-center">
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                <div class="stat-card shadow-sm p-4 rounded">
                    <h2 class="text-primary fw-bold">@Model.TeamsCount</h2>
                    <p class="text-muted">Teams</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-card shadow-sm p-4 rounded">
                    <h2 class="text-primary fw-bold">@Model.PlayersCount</h2>
                    <p class="text-muted">Players</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                <div class="stat-card shadow-sm p-4 rounded">
                    <h2 class="text-primary fw-bold">@Model.CoachesCount</h2>
                    <p class="text-muted">Coaches</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="400">
                <div class="stat-card shadow-sm p-4 rounded">
                    <h2 class="text-primary fw-bold">34</h2>
                    <p class="text-muted">Matches</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- AOS JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script>
    AOS.init({
        duration: 1000,
        once: true
    });
</script>
