@model ClubMaster3.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 500px; width: 100%; background: rgba(255,255,255,0.97);">
        <h2 class="text-center mb-4 fw-bold">Register</h2>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="form-group mb-3">
                <label asp-for="FirstName" class="fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                    <input asp-for="FirstName" class="form-control" placeholder="First name" />
                </div>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="LastName" class="fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-person-badge-fill"></i></span>
                    <input asp-for="LastName" class="form-control" placeholder="Last name" />
                </div>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Username" class="fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                    <input asp-for="Username" class="form-control" placeholder="Choose a username" />
                </div>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Password" class="fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Create a password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn w-100 fw-bold mb-2" style="background-color: #89CFF0; border-color: #89CFF0; color: #fff;">Register</button>
        </form>
        <div class="text-center mt-2">
            <span class="text-muted">Already have an account?</span>
            <a asp-action="Login" class="fw-bold">Login here</a>.
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
} 