@model IEnumerable<ClubMaster3.Models.Coach>
@{
    ViewData["Title"] = "Coaches List";
}

<div class="main-content">
    <div class="section">
        <h2 class="text-center mb-4">Coaches List</h2>

        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coach in Model)
                    {
                        <tr>
                            <td>@coach.Id</td>
                            <td>@coach.Name</td>
                            <td>@coach.Phone</td>
                            <td>@coach.Salary</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@coach.Id" class="btn btn-sm btn-outline-info">View</a>
                                <a asp-action="Edit" asp-route-id="@coach.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@coach.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-action="Create" class="btn btn-primary mt-3">Add New Coach</a>
    </div>
</div>
