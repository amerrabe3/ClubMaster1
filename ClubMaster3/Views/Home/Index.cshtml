@model ClubMaster3.Models.HomeStatsViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- ✅ AOS CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet" />

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #f4f6f8;
    }

    .carousel-item img {
        max-height: 400px;
        object-fit: cover;
    }

    .carousel-caption h5,
    .carousel-caption p {
        color: white;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);
    }
</style>

<!-- ✅ Hero Section -->
<section class="d-flex align-items-center justify-content-center text-center"
         style="min-height: 90vh; background-image: url('/images/hero-bg.jpg'); background-size: cover; background-position: center; backdrop-filter: blur(3px);">
    <div class="container">
        <div data-aos="zoom-in">
            <h1 class="fw-bold text-white mb-3" style="font-size: 2.2rem;">
                All Your Club Data, One Smart Dashboard.
            </h1>
            <p class="text-light mb-4" style="font-size: 1.1rem;">
                Manage teams, players, and coaches in one clean interface.
            </p>
            <a href="#clubCarousel" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm" data-aos="fade-up">
                Explore Now
            </a>
        </div>
    </div>
</section>

<!-- ✅ Carousel Section -->
<section class="py-4" style="background: transparent;">
    <div id="clubCarousel" class="carousel slide" data-bs-ride="carousel" data-aos="fade-up">
        <div class="carousel-inner">
            @foreach (var player in Model.Players)
            {
                <div class="carousel-item @(player == Model.Players.First() ? "active" : "")">
                    <img src="@(!string.IsNullOrEmpty(player.ImagePath) ? player.ImagePath : "/images/default-player.jpg")"
                         class="d-block w-100" />
                    <div class="carousel-caption p-2">
                        <h5>@player.Name</h5>
                        <p>Player - @player.Position</p>
                    </div>
                </div>
            }
            @foreach (var coach in Model.Coaches)
            {
                <div class="carousel-item">
                    <img src="@(!string.IsNullOrEmpty(coach.ImagePath) ? coach.ImagePath : "/images/default-coach.jpg")"
                         class="d-block w-100" />
                    <div class="carousel-caption p-2">
                        <h5>@coach.Name</h5>
                        <p>Coach - @coach.Phone</p>
                    </div>
                </div>
            }
            @foreach (var team in Model.Teams)
            {
                <div class="carousel-item">
                    <img src="@(!string.IsNullOrEmpty(team.ImagePath) ? team.ImagePath : "/images/default-team.jpg")"
                         class="d-block w-100" />
                    <div class="carousel-caption p-2">
                        <h5>@team.Name</h5>
                        <p>Team - @team.City</p>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#clubCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#clubCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</section>

<!-- ✅ Statistics Section -->
<section class="py-5" style="background: transparent;">
    <div class="container">
        <div class="row g-4 justify-content-center text-center">
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                <div class="p-4 bg-white bg-opacity-75 rounded-4">
                    <h3 class="text-primary fw-bold mb-1">@Model.TeamsCount</h3>
                    <p class="text-muted m-0">Teams</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                <div class="p-4 bg-white bg-opacity-75 rounded-4">
                    <h3 class="text-primary fw-bold mb-1">@Model.PlayersCount</h3>
                    <p class="text-muted m-0">Players</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                <div class="p-4 bg-white bg-opacity-75 rounded-4">
                    <h3 class="text-primary fw-bold mb-1">@Model.CoachesCount</h3>
                    <p class="text-muted m-0">Coaches</p>
                </div>
            </div>
           
            </div>
        </div>
    </div>
</section>

<!-- ✅ AOS JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script>
    AOS.init({
        duration: 1000,
        once: false
    });
</script>

