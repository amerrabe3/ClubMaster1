@model ClubMaster3.Models.Player

@{
    ViewData["Title"] = "Delete Player";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 500px; width: 100%; background: rgba(255,255,255,0.97);">
        <h2 class="text-center mb-4 text-danger fw-bold">Delete Player</h2>
        <div class="alert alert-warning text-center mb-4">
            Are you sure you want to delete this player?
        </div>
        <dl class="row mb-4">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Position</dt>
            <dd class="col-sm-8">@Model.Position</dd>
            <dt class="col-sm-4">Shirt Number</dt>
            <dd class="col-sm-8">@Model.ShirtNum</dd>
            <dt class="col-sm-4">Age</dt>
            <dd class="col-sm-8">@Model.Age</dd>
        </dl>
        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex align-items-center">
                <button type="submit" class="btn btn-danger w-50 fw-bold me-2">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-50 fw-bold">Cancel</a>
            </div>
        </form>
    </div>
</div>

