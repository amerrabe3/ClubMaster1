@model ClubMaster3.Models.Player

<h2 class="text-danger mb-4">Delete Player</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this player?
</div>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Position</dt>
        <dd class="col-sm-9">@Model.Position</dd>

        <dt class="col-sm-3">Shirt Number</dt>
        <dd class="col-sm-9">@Model.ShirtNum</dd>

        <dt class="col-sm-3">Age</dt>
        <dd class="col-sm-9">@Model.Age</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

