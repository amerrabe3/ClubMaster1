@model ClubMaster3.Models.Match

@{
    ViewData["Title"] = "Create Match";
}

<div class="main-content">
    <div class="section">
        <h2 class="text-center mb-4">Create New Match</h2>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="TeamAId" class="form-label">Team A</label>
                        <select asp-for="TeamAId" class="form-select" asp-items="ViewBag.TeamAId"></select>
                        <span asp-validation-for="TeamAId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TeamBId" class="form-label">Team B</label>
                        <select asp-for="TeamBId" class="form-select" asp-items="ViewBag.TeamBId"></select>
                        <span asp-validation-for="TeamBId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="MatchDateTime" class="form-label">Match Date & Time</label>
                        <input asp-for="MatchDateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="MatchDateTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Location" class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ScoreA" class="form-label">Score Team A</label>
                        <input asp-for="ScoreA" class="form-control" />
                        <span asp-validation-for="ScoreA" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ScoreB" class="form-label">Score Team B</label>
                        <input asp-for="ScoreB" class="form-control" />
                        <span asp-validation-for="ScoreB" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        <input type="submit" value="Create Match" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
