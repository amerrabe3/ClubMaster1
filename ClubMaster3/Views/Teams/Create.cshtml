@model ClubMaster3.Models.Team

<h2 class="mb-4">Add New Team</h2>

<form asp-action="Create" enctype="multipart/form-data">
    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="City" class="form-label">City</label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="CoachId" class="form-label">Coach ID</label>
        <input asp-for="CoachId" class="form-control" />
        <span asp-validation-for="CoachId" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label for="ImageFile" class="form-label">Upload Image</label>
        <input type="file" class="form-control" name="ImageFile" />
    </div>

    <div class="d-flex align-items-center">
        <button type="submit" class="btn btn-success me-2">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

