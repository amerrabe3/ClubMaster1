@model IEnumerable<ClubMaster3.Models.Team>
@{
    ViewData["Title"] = "Teams List";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg p-4 rounded-4 w-100" style="max-width: 900px; background: rgba(255,255,255,0.97);">
        <h2 class="text-center mb-4 fw-bold">Teams List</h2>
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>City</th>
                        <th>Founded Year</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Model)
                    {
                        <tr>
                            <td>@team.Id</td>
                            <td>@team.Name</td>
                            <td>@team.City</td>
                            <td>@team.FoundedYear</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@team.Id" class="btn btn-sm btn-outline-info me-1">View</a>
                                <a asp-action="Edit" asp-route-id="@team.Id" class="btn btn-sm btn-outline-warning me-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@team.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-4">
            <a asp-action="Create" class="btn btn-primary fw-bold px-4">Create New Team</a>
        </div>
    </div>
</div>
