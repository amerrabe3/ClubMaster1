@model ClubMaster3.Models.Team

@{
    ViewData["Title"] = "Edit Team";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 500px; width: 100%; background: rgba(255,255,255,0.97);">
        <h2 class="text-center mb-4 fw-bold">Edit Team</h2>
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CoachId" class="form-label fw-semibold">Coach ID</label>
                <input asp-for="CoachId" class="form-control" />
                <span asp-validation-for="CoachId" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label for="ImageFile" class="form-label fw-semibold">Upload Image</label>
                <input type="file" class="form-control" name="ImageFile" />
            </div>
            <div class="d-flex align-items-center">
                <button type="submit" class="btn btn-primary w-50 fw-bold me-2">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-50 fw-bold">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
