@model ClubMaster3.Models.Match

@{
    ViewData["Title"] = "Edit Match";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 600px; width: 100%; background: rgba(255,255,255,0.97);">
        <h2 class="text-center mb-4 fw-bold">Edit Match</h2>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="TeamAId" class="form-label fw-semibold">Team A</label>
                <select asp-for="TeamAId" class="form-select" asp-items="ViewBag.TeamAId"></select>
                <span asp-validation-for="TeamAId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="TeamBId" class="form-label fw-semibold">Team B</label>
                <select asp-for="TeamBId" class="form-select" asp-items="ViewBag.TeamBId"></select>
                <span asp-validation-for="TeamBId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="MatchDateTime" class="form-label fw-semibold">Match Date & Time</label>
                <input asp-for="MatchDateTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="MatchDateTime" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Location" class="form-label fw-semibold">Location</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ScoreA" class="form-label fw-semibold">Score Team A</label>
                <input asp-for="ScoreA" class="form-control" />
                <span asp-validation-for="ScoreA" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="ScoreB" class="form-label fw-semibold">Score Team B</label>
                <input asp-for="ScoreB" class="form-control" />
                <span asp-validation-for="ScoreB" class="text-danger"></span>
            </div>
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary w-50 fw-bold me-2">Back to List</a>
                <button type="submit" class="btn btn-primary w-50 fw-bold">Save</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
