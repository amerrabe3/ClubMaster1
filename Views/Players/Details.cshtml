@model ClubMaster3.Models.Player

@{
    ViewData["Title"] = "Player Details";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 500px; width: 100%; background: rgba(255,255,255,0.97);">
        <h2 class="text-center mb-4 fw-bold">Player Details</h2>
        <dl class="row mb-4">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Position</dt>
            <dd class="col-sm-8">@Model.Position</dd>
            <dt class="col-sm-4">Shirt Number</dt>
            <dd class="col-sm-8">@Model.ShirtNum</dd>
            <dt class="col-sm-4">Age</dt>
            <dd class="col-sm-8">@Model.Age</dd>
            <dt class="col-sm-4">Team ID</dt>
            <dd class="col-sm-8">@Model.TeamId</dd>
        </dl>
        <div class="d-flex justify-content-between">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold">Edit</a>
            <a asp-action="Index" class="btn btn-secondary fw-bold">Back to List</a>
        </div>
    </div>
</div>

